# ==============================================================================
# Cite Platform - Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=cite_user
POSTGRES_PASSWORD=cite_password
POSTGRES_DB=cite_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://cite_user:cite_password@localhost:5434/cite_db

# Redis & Background Queue (ARQ)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381/0

# JWT Auth & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Providers (Zero cost / Free tiers)
# Groq (Primary high-speed free tier: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (Fallback free tier: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (Optional fallback: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM Failover Order (comma-separated: groq,gemini,ollama)
LLM_PROVIDER_ORDER=groq,gemini

# Embedding & Reranker Configuration (100% Free & Local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-TinyBERT-L-2-v2

# Multimodal Document Vision (PyMuPDF + Gemini Flash Captioner - disabled by default)
MULTIMODAL_ENABLED=false
MULTIMODAL_MAX_IMAGES_PER_DOC=10
MULTIMODAL_MIN_DIMENSION=150

# Rate Limits (Queries per minute for free tier protection)
RATE_LIMIT_GROQ_RPM=25
RATE_LIMIT_GEMINI_RPM=12
RATE_LIMIT_PER_USER_RPM=30
